#!/usr/bin/env bash
set -euo pipefail

# Which account to manage is never hardcoded and never taken from arguments.
# Status checks use the user running this script. Changes use the uid that
# pkexec (PKEXEC_UID) or sudo (SUDO_UID) records for the user who asked, so
# nobody can name a different account.

readonly USERNAME_RE='^[a-z_][a-z0-9_-]{0,31}$'

die() {
  printf 'passwordless-sudo: %s\n' "$*" >&2
  exit 1
}

require_root() {
  (( EUID == 0 )) || die "this operation requires administrator authentication"
}

check_username() {
  # sudo silently ignores sudoers.d files whose names contain a dot, and the
  # name is written into the rule, so only plain account names are accepted.
  [[ "$1" =~ $USERNAME_RE ]] || die "unsupported user name: $1"
}

rule_file()  { printf '/etc/sudoers.d/90-passwordless-sudo-%s' "$1"; }
state_file() { printf '/var/lib/passwordless-sudo-%s.enabled' "$1"; }
rule_for()   { printf '%s ALL=(ALL:ALL) NOPASSWD: ALL' "$1"; }

current_user() {
  local name
  name="$(id -un)"
  check_username "$name"
  printf '%s' "$name"
}

requesting_user() {
  local uid="${PKEXEC_UID:-${SUDO_UID:-}}" name
  [[ "$uid" =~ ^[0-9]+$ ]] || die "cannot tell which user asked for this; use --toggle"
  (( uid != 0 )) || die "refusing to manage passwordless sudo for root"
  name="$(id -nu -- "$uid" 2>/dev/null)" || die "no account with uid $uid"
  check_username "$name"
  printf '%s' "$name"
}

rule_is_active() {
  # The bar polls on every monitor. Reading the sudoers drop-in itself would
  # require sudo and flood the journal with failed noninteractive checks while
  # disabled, so the authenticated writer maintains a public, content-free
  # state marker alongside the validated root-only rule.
  [[ -e "$(state_file "$1")" ]]
}

enable_rule() {
  require_root
  local user rule_path state_path temporary
  user="$(requesting_user)"
  rule_path="$(rule_file "$user")"
  state_path="$(state_file "$user")"
  [[ ! -e "$rule_path" ]] || die "refusing to overwrite existing $rule_path"

  temporary="$(mktemp /etc/sudoers.d/.passwordless-sudo-toggle.XXXXXX)"
  # shellcheck disable=SC2064  # expand now: the variable is local
  trap "rm -f '$temporary'" EXIT

  rule_for "$user" > "$temporary"
  printf '\n' >> "$temporary"
  chown root:root "$temporary"
  chmod 0440 "$temporary"
  /usr/sbin/visudo -cf "$temporary" >/dev/null
  mv "$temporary" "$rule_path"
  install -o root -g root -m 0444 /dev/null "$state_path"
  trap - EXIT

  logger --tag passwordless-sudo "enabled passwordless sudo for $user"
}

disable_rule() {
  require_root
  local user rule_path
  user="$(requesting_user)"
  rule_path="$(rule_file "$user")"
  [[ -e "$rule_path" ]] || exit 0

  local -a lines=()
  mapfile -t lines < "$rule_path"
  if (( ${#lines[@]} != 1 )) || [[ "${lines[0]}" != "$(rule_for "$user")" ]]; then
    die "refusing to remove unrecognized contents from $rule_path"
  fi

  rm -f -- "$rule_path" "$(state_file "$user")"
  logger --tag passwordless-sudo "disabled passwordless sudo for $user"
}

(( $# == 1 )) || die "usage: $0 --status|--toggle|--enable|--disable"

case "$1" in
  --status)
    rule_is_active "$(current_user)"
    ;;
  --toggle)
    if rule_is_active "$(current_user)"; then
      exec sudo -n -- "$0" --disable
    else
      exec pkexec "$0" --enable
    fi
    ;;
  --enable)
    enable_rule
    ;;
  --disable)
    disable_rule
    ;;
  *)
    die "usage: $0 --status|--toggle|--enable|--disable"
    ;;
esac
